  },
  "promo_requirement": {
    "rule": "Every make.fun social video post or ad ends with this card: 9:16 for TikTok, Reels and Shorts, 16:9 or 9:16 for X. The field carries the poster's own make.fun referral code, typed in; never leave it empty and never use someone else's code.",
    "applies_to": "Every make.fun social video post or ad.",
    "platforms": [
      {
        "platform": "TikTok",
        "aspects": [
          "9:16"
        ],
        "overlay": [
          "https://make.fun/press/referral-card/9x16/makefun-card-9x16-transparent.webm"
        ]
      },
      {
        "platform": "Instagram Reels",
        "aspects": [
          "9:16"
        ],
        "overlay": [
          "https://make.fun/press/referral-card/9x16/makefun-card-9x16-transparent.webm"
        ]
      },
      {
        "platform": "YouTube Shorts",
        "aspects": [
          "9:16"
        ],
        "overlay": [
          "https://make.fun/press/referral-card/9x16/makefun-card-9x16-transparent.webm"
        ]
      },
      {
        "platform": "X",
        "aspects": [
          "16:9",
          "9:16"
        ],
        "overlay": [
          "https://make.fun/press/referral-card/16x9/makefun-card-16x9-transparent.webm",
          "https://make.fun/press/referral-card/9x16/makefun-card-9x16-transparent.webm"
        ]
      }
    ],
    "code": {
      "format": "8 characters of 0-9 and a-z without i, l, o and u",
      "link_form": "https://make.fun/r/<code>",
      "where_people_find_it": "https://make.fun/profile?tab=referrals",
      "where_agents_find_it": "GET https://make.fun/api/agents/me, referrals.code; or the MCP tool get_referrals"
    },
    "steps": [
      "Put the transparent card on the track above your clip, 2.5 seconds before it ends, or add the card on magenta after it.",
      "From that frame, blur the clip about 28 px and turn its saturation down, both easing in over about 0.8 seconds.",
      "Once the field comes to rest, type your own referral code where the caret blinks, in JetBrains Mono Bold or Inter Bold, in ink #191419."
    ]
  },
